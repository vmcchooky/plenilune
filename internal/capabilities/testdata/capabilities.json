      },
      "max_witnesses": {
        "default": 8,
        "max": 64
      }
    },
    "prefix_list": {
      "max_entries": 10000
    },
    "analysis": {
      "max_analyzed": {
        "default": 16,
        "max": 64
      },
      "max_classes": {
        "default": 32,
        "max": 128
      },
      "deadline_ms": {
        "default": 30000,
        "max": 120000
      }
    },
    "ai_session": {
      "max_model_requests": {
        "default": 16,
        "max": 32
      },
      "max_tool_calls": {
        "default": 24,
        "max": 64
      },
      "max_repair_proposals": {
        "default": 6,
        "max": 16
      },
      "max_output_corrections": {
        "default": 2,
        "max": 8
      },
      "session_deadline_default_ms": 120000
    }
  },
  "options": [
