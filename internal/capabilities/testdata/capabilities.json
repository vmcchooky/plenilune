  "domains": [
    {
      "id": "acl",
      "description": "Cisco IOS named extended IPv4 ACL",
      "parser_version": "cisco-acl/v0.2",
      "engine_version": "acl-exact/v0.4"
    },
    {
      "id": "prefix-list",
      "description": "Cisco IOS IPv4 prefix-list",
      "parser_version": "cisco-prefix-list/v0.2",
      "engine_version": "prefix-list-exact/v0.2"
    }
  ],
  "limits": {
    "acl": {
      "max_rules": 512,
      "max_lines": 10000,
      "max_input_bytes": 2097152,
      "max_operations": {
        "default": 2000000,
        "max": 2000000
      },
      "max_boxes": {
        "default": 50000,
        "max": 50000
      },
      "timeout_ns": {
        "default": 2000000000,
